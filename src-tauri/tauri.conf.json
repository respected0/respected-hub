{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respected Hub",
  "version": "0.1.0-beta.1",
  "identifier": "com.respected.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Respected Hub", "width": 1200, "height": 850, "minWidth": 820, "minHeight": 600, "decorations": false, "backgroundColor": "#161e29" }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
